# Copy to .env and fill in. .env is gitignored; this example is committed.
QC_REPO=<owner>/<repo>
QC_SITE=https://<your-domain>/
QC_SERVER=<your-server-host>
GH_ASKPASS=C:/Tools/gh-askpass.sh
GH_TOKEN_FILE=C:/Tools/.ghtoken
QC_UPDATER_KEY=C:/Tools/qc-updater.key
QC_UPDATER_PASS=C:/Tools/qc-updater-pass.txt
QC_KEYSTORE=C:/Tools/qc-release.keystore
QC_KEYSTORE_PASS=C:/Tools/qc-keystore-pass.txt
QC_EMBED_KEY=embed/quotacards-embed.pem
